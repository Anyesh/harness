<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.harness.second-brain</string>
  <key>ProgramArguments</key>
  <array>
    <string>@SB_API@</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>SECOND_BRAIN_DB</key>
    <string>@HOME@/.second-brain/brain.db</string>
    <key>SECOND_BRAIN_BIND</key>
    <string>127.0.0.1:7200</string>
    <key>FASTEMBED_CACHE_DIR</key>
    <string>@HOME@/.second-brain/fastembed</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/second-brain.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/second-brain.log</string>
</dict>
</plist>
