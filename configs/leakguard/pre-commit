#!/usr/bin/env bash
# Global pre-commit dispatcher in ~/.config/git/hooks/ (core.hooksPath). The
# leak scan itself is the config hook hook.leakguard; this file only chains to
# the repo-local hook, which a global core.hooksPath would otherwise hide.
set -uo pipefail

# Deliberately --git-dir, not --git-path: --git-path resolves through
# core.hooksPath and would re-run this dispatcher forever.
repo_hook="$(git rev-parse --git-dir)/hooks/pre-commit"
if [[ -x "$repo_hook" ]]; then
  exec "$repo_hook" "$@"
fi
exit 0
