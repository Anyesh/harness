{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "bash {{HOME_DIR}}/.cursor/hooks/session-start.sh",
        "timeout": 5
      },
      {
        "command": "node {{HOME_DIR}}/.cursor/hooks/humanize-activate.js",
        "timeout": 5
      },
      {
        "command": "node {{HOME_DIR}}/.cursor/hooks/ownit-activate.js",
        "timeout": 5
      },
      {
        "command": "bash {{HOME_DIR}}/.cursor/hooks/session-start-wiki.sh",
        "timeout": 5,
        "additional_context": true
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node {{HOME_DIR}}/.cursor/hooks/humanize-mode-tracker.js",
        "timeout": 5
      },
      {
        "command": "node {{HOME_DIR}}/.cursor/hooks/ownit-mode-tracker.js",
        "timeout": 5
      },
      {
        "command": "bash {{HOME_DIR}}/.cursor/hooks/wiki-nudge.sh",
        "timeout": 5,
        "additional_context": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "bash {{HOME_DIR}}/.cursor/hooks/pre-bash-guard.sh",
        "timeout": 5
      },
      {
        "command": "bash {{HOME_DIR}}/.cursor/hooks/cost-guard.sh",
        "timeout": 5
      },
      {
        "command": "command -v rtk >/dev/null && rtk hook cursor || exit 0",
        "timeout": 5
      }
    ],
    "beforeReadFile": [
      {
        "command": "bash {{HOME_DIR}}/.cursor/hooks/cost-guard.sh",
        "timeout": 5
      }
    ],
    "afterFileEdit": [
      {
        "command": "bash {{HOME_DIR}}/.cursor/hooks/format-on-save.sh",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "bash {{HOME_DIR}}/.cursor/hooks/stop-sloppiness-guard.sh",
        "timeout": 10,
        "loop_limit": 3
      },
      {
        "command": "bash {{HOME_DIR}}/.cursor/hooks/stop-wiki-enforce.sh",
        "timeout": 10
      },
      {
        "command": "bash {{HOME_DIR}}/.cursor/hooks/session-end-ingest.sh",
        "timeout": 10
      }
    ]
  }
}
