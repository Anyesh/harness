{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "bash ./hooks/session-start.sh",
        "timeout": 5
      },
      {
        "command": "node ./hooks/humanize-activate.js",
        "timeout": 5
      },
      {
        "command": "node ./hooks/ownit-activate.js",
        "timeout": 5
      },
      {
        "command": "bash ./hooks/session-start-wiki.sh",
        "timeout": 5
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node ./hooks/humanize-mode-tracker.js",
        "timeout": 5
      },
      {
        "command": "node ./hooks/ownit-mode-tracker.js",
        "timeout": 5
      },
      {
        "command": "bash ./hooks/context-cold-start-guard.sh",
        "timeout": 5
      },
      {
        "command": "bash ./hooks/wiki-nudge.sh",
        "timeout": 5
      },
      {
        "command": "bash ./hooks/scope-drift-detector.sh",
        "timeout": 5
      },
      {
        "command": "bash ./hooks/cleanup-nudge.sh",
        "timeout": 5
      }
    ],
    "preToolUse": [
      {
        "command": "bash ./hooks/pre-edit-code-quality.sh",
        "matcher": "Write|StrReplace",
        "timeout": 5
      },
      {
        "command": "python3 ./hooks/pre-edit-comment-guard.py",
        "matcher": "Write|StrReplace",
        "timeout": 5
      },
      {
        "command": "bash ./hooks/cost-guard.sh",
        "matcher": "Read|Shell",
        "timeout": 5
      }
    ],
    "beforeShellExecution": [
      {
        "command": "bash ./hooks/pre-bash-guard.sh",
        "timeout": 5
      }
    ],
    "afterFileEdit": [
      {
        "command": "bash ./hooks/format-on-save.sh",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "bash ./hooks/stop-sloppiness-guard.sh",
        "timeout": 10,
        "loop_limit": 3
      },
      {
        "command": "bash ./hooks/stop-wiki-enforce.sh",
        "timeout": 10
      }
    ],
    "sessionEnd": [
      {
        "command": "bash ./hooks/session-end-ingest.sh",
        "timeout": 10
      }
    ],
    "preCompact": [
      {
        "command": "bash ./hooks/context-cold-start-guard.sh",
        "timeout": 5
      },
      {
        "command": "bash ./hooks/pre-compact.sh",
        "timeout": 10
      }
    ]
  }
}
