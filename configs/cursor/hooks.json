{
  "hooks": [
    {
      "event": "beforeShellExecution",
      "command": "bash {{HOME_DIR}}/.cursor/hooks/pre-bash-guard.sh",
      "timeout": 5000,
      "failClosed": true
    },
    {
      "event": "afterFileEdit",
      "command": "bash {{HOME_DIR}}/.cursor/hooks/format-on-save.sh",
      "timeout": 10000
    },
    {
      "event": "preToolUse",
      "command": "python3 {{HOME_DIR}}/.cursor/hooks/pre-edit-comment-guard.py",
      "matcher": "edit|write|apply_patch",
      "timeout": 5000,
      "failClosed": true
    },
    {
      "event": "preToolUse",
      "command": "bash {{HOME_DIR}}/.cursor/hooks/cost-guard.sh",
      "matcher": "read|bash|shell",
      "timeout": 5000
    }
  ]
}
