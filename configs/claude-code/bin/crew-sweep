#!/usr/bin/env bash
# Usage: crew-sweep [seconds]   (default 900; 0 compares once without waiting)
#
# Refreshes the dagr run file with crew-dagr after the role check, every 60 s
# while waiting and before exiting; its failures never reach the output.
#
# Output lines:
#   SUPERSEDED                      crew-role answered none; stop acting as lead
#   ALL-DONE                        every board row is done or blocked; POOL, SPARE
#                                   and LEFTOVER lines come first unless herdr fails
#   ERROR <step>: <message>         a failed crew-role or herdr call, retried
#   CHANGED <path> / REMOVED <path> item files that differ from the last sweep
#   TIMEOUT                         nothing changed within the wait and no resource
#                                   breach ended it
#   RESOURCE <line>                 each breach crew-resources (beside this script)
#                                   prints, checked before the wait, every
#                                   CREW_RESOURCE_EVERY seconds (default 30) and at
#                                   the end; one whose key (disk <mount>, plus
#                                   disk <mount> critical, memory, load or io) has no
#                                   alert in .sweep-resources from the last
#                                   CREW_RESOURCE_HOLD seconds (default 600) ends the wait
#   RESOURCE failed: <message>      crew-resources failed; this never ends the wait
#   LIMIT <profile> <session|week> <x>% resets in <m> min
#     a profile with live crew workers ($slug-w<N>), or the lead's own, at or above
#     CREW_SESSION_HARD_PCT or CREW_WEEK_HARD_PCT; checked when RESOURCE is, it
#     ends the wait once per profile and window (.sweep-limits)
#   GONE <owner>                    an assigned owner herdr no longer lists
#   WORKER <owner> item <id> <herdr status> on <profile>[ CONTEXT <n>k][ MERGING|IDLE][ QUIET][ DIALOG]
#     the profile is ? until the session's statusline writes its usage file;
#     CONTEXT means at least CREW_CONTEXT_K thousand tokens or 80% of the
#     session's context window, and ends the wait once per session;
#     a DIALOG line is followed by the owner's screen, each line indented two spaces;
#     MERGING means a running or queued crew-merge; QUIET means no progress for
#     CREW_QUIET seconds (default 3600), or for a running merge a merging file that old
#   SPARE <name> <herdr status> on <profile>[ holds <id>][ CONTEXT <n>k]
#                                   a live crew worker owning no assigned row; holds
#                                   names a blocked row it owns
#   SPARE <label> no agent          a crew worker's tab with no live agent of that
#                                   name, unless an assigned row names it (GONE)
#   POOL <profile> <crew>/<all>/<cap> session <x>% week <y>%[ FULL]
#     for each claude-profile name and default: live crew workers and all live
#     Claude agents on it, CREW_WORKERS_PER_PROFILE, and its usage (?% unknown);
#     FULL at the cap or at CREW_SESSION_SOFT_PCT or CREW_WEEK_SOFT_PCT
#   LEFTOVER <id> <worktree|branch|build-dir> <path or ref>
#     a done or blocked row whose merged tip is in its into branch and whose
#     landing finished, with that left over; once each (.sweep-leftovers)
#   STALE-MERGE <id>                an item whose merging file a dead crew-merge left
#   READY <id>                      an open row whose deps are all done
#   DEPS <id> <problem>             an open row that can never start: names unknown
#                                   <dep>, waits on blocked <dep>, is in a cycle, or
#                                   waits on stuck <dep>
#   HEAVY <holder> <minutes> min <purpose>
#                                   with heavy-slots, a heavy slot held longer than
#                                   CREW_HEAVY_LONG seconds (default 5400); a lock
#                                   with no holder file is aged by its directory
#   HEAVY failed: <message>         heavy-slots holds something other than 1
#   REFLECT                         reflections.md is missing or older than
#                                   CREW_REFLECT_EVERY seconds (default 2700)
#   CHECK <line>                    the last 20 lines of $crew/sweep-check, run in
#                                   the main checkout
#   CHECK failed: <message>         sweep-check exited non-zero, timed out or is not
#                                   executable
#
# The usage and context thresholds come from the environment or $crew/thresholds,
# whose bad lines only crew-resources reports.
set -uo pipefail

here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
# shellcheck source=crew-lib.sh
. "$here/crew-lib.sh"

limit=${1:-900}
[[ $limit =~ ^[0-9]+$ ]] || {
  echo "usage: crew-sweep [seconds]" >&2
  exit 2
}
retry_wait=${CREW_SWEEP_RETRY_WAIT:-10}
retries=30
screen_lines=12
publish_every=${CREW_DAGR_INTERVAL:-60}
quiet=${CREW_QUIET:-3600}
reflect_every=${CREW_REFLECT_EVERY:-2700}
check_timeout=${CREW_SWEEP_CHECK_TIMEOUT:-30}
heavy_long=${CREW_HEAVY_LONG:-5400}
resource_every=${CREW_RESOURCE_EVERY:-30}
resource_hold=${CREW_RESOURCE_HOLD:-600}

crew=$(crew_dir) || {
  echo "crew-sweep: not inside a git repository" >&2
  exit 1
}
main=$(crew_main)
board="$crew/board.tsv"
seen="$crew/.sweep-seen"
alerts="$crew/.sweep-resources"
limits="$crew/.sweep-limits"
leftovers="$crew/.sweep-leftovers"
usage_dir=$(crew_usage_dir)
slug=$(crew_slug)
crew_re="^$slug-w[0-9]+\$"

crew_read_thresholds "$crew/thresholds"
session_soft=$((10#$(crew_threshold CREW_SESSION_SOFT_PCT 70)))
session_hard=$((10#$(crew_threshold CREW_SESSION_HARD_PCT 90)))
week_soft=$((10#$(crew_threshold CREW_WEEK_SOFT_PCT 85)))
week_hard=$((10#$(crew_threshold CREW_WEEK_HARD_PCT 95)))
context_k_limit=$((10#$(crew_threshold CREW_CONTEXT_K 400)))
profile_cap=$((10#$(crew_threshold CREW_WORKERS_PER_PROFILE 5)))

role_once() {
  local out err rc
  err=$(mktemp)
  out=$(timeout 2 crew-role 2>"$err")
  rc=$?
  if ((rc == 124)); then
    REPLY="timed out after 2 s"
  elif ((rc != 0)); then
    REPLY="exit $rc: $(tr '\n' ' ' <"$err")"
  else
    REPLY=$out
  fi
  rm -f "$err"
  ((rc == 0))
}

check_role() {
  local i
  for ((i = 1; i <= retries; i++)); do
    if role_once; then
      case $REPLY in
      lead) return 0 ;;
      none)
        echo SUPERSEDED
        exit 0
        ;;
      worker)
        echo "ERROR crew-role: this session is a crew worker, not the lead"
        exit 1
        ;;
      *) REPLY="unexpected answer: $REPLY" ;;
      esac
    fi
    echo "ERROR crew-role: $REPLY"
    sleep "$retry_wait"
  done
  echo "ERROR crew-role: still failing after $retries attempts"
  exit 1
}

all_done() {
  [[ -f $board ]] || return 1
  awk -F'\t' '
    $2 ~ /^(open|assigned|done|blocked)$/ { rows++ }
    $2 == "open" || $2 == "assigned" { busy = 1 }
    END { exit !(rows > 0 && !busy) }
  ' "$board"
}

snapshot() {
  local files
  shopt -s nullglob
  files=("$crew"/items/*/report.md "$crew"/items/*/review.md "$crew"/items/*/merged)
  shopt -u nullglob
  ((${#files[@]})) || return 0
  stat --printf '%n\t%.9Y\t%s\n' "${files[@]}" 2>/dev/null | LC_ALL=C sort
}

# Every agent herdr lists, in any workspace, one line each in agent_rows with
# fields split by \037: name (empty when unnamed), status, session id, then
# the session's profile, context tokens and context window, ? when unknown.
agent_rows=
load_agents() {
  local name status sid usage
  agent_rows=$(
    jq -r '.result.agents[] | [.name, .agent_status, .agent_session.value?] | map(. // "" | tostring) | join("\u001f")' <<<"$1" |
      while IFS=$'\037' read -r name status sid; do
        usage=$(crew_session_usage "$sid") && [[ -n $usage ]] || usage=$'?\t?\t?'
        printf '%s\037%s\037%s\037%s\n' "$name" "$status" "$sid" "${usage//$'\t'/$'\037'}"
      done
  )
}

agents_once() {
  local out
  if ! out=$(timeout 10 herdr agent list 2>&1); then
    REPLY=${out//$'\n'/ }
    return 1
  fi
  if ! jq -e '.result.agents | type == "array"' <<<"$out" >/dev/null 2>&1; then
    REPLY="unexpected output: ${out:0:200}"
    REPLY=${REPLY//$'\n'/ }
    return 1
  fi
  load_agents "$out"
}

agent_list() {
  local i
  for ((i = 1; i <= retries; i++)); do
    agents_once && return 0
    echo "ERROR herdr agent list: $REPLY"
    sleep "$retry_wait"
  done
  echo "ERROR herdr agent list: still failing after $retries attempts"
  exit 1
}

agent_fields() {
  local fields
  [[ -n $1 ]] || return 1
  fields=$(awk -F'\037' -v n="$1" '$1 == n { print $2 "\037" $4 "\037" $5 "\037" $6; f = 1; exit } END { exit !f }' <<<"$agent_rows") ||
    return 1
  IFS=$'\037' read -r agent_status agent_profile agent_tokens agent_window <<<"$fields"
}

context_k() {
  local tokens=$1 window=$2
  [[ $tokens =~ ^[0-9]+$ ]] || return 1
  if ((tokens >= context_k_limit * 1000)) || { [[ $window =~ ^[0-9]+$ ]] && ((window > 0 && tokens * 100 >= window * 80)); }; then
    echo $((tokens / 1000))
  else
    return 1
  fi
}

usage_flags() {
  local k
  printf ' on %s' "$agent_profile"
  if k=$(context_k "$agent_tokens" "$agent_window"); then printf ' CONTEXT %sk' "$k"; fi
}

at_least() {
  [[ $1 =~ ^[0-9]+$ ]] && (($1 >= $2))
}

# `profile window pct resets` for each window at or above its hard threshold,
# on profiles that have live crew workers or the lead.
limit_crossings() {
  local p sp sr wp wr
  while IFS= read -r p; do
    [[ -n $p ]] || continue
    read -r sp sr wp wr < <(crew_profile_usage "$p")
    if at_least "${sp:-}" "$session_hard" && [[ ${sr:-} =~ ^[0-9]+$ ]]; then echo "$p session $sp $sr"; fi
    if at_least "${wp:-}" "$week_hard" && [[ ${wr:-} =~ ^[0-9]+$ ]]; then echo "$p week $wp $wr"; fi
  done < <(awk -F'\037' -v re="$crew_re" -v lead="$slug-lead" '
    ($1 ~ re || $1 == lead) && $4 != "?" && $4 != "" && !seen[$4]++ { print $4 }
  ' <<<"$agent_rows")
}

report_limits() {
  local p w pct resets
  while read -r p w pct resets; do
    [[ -n $p ]] || continue
    echo "LIMIT $p $w $pct% resets in $(((resets - EPOCHSECONDS + 59) / 60)) min"
  done < <(limit_crossings)
}

# usage_seen holds `limit <profile> <window>` with the resets alerted and
# `context <session id>` with when; a crossing whose resets is within 300 s of
# the alerted one is the same window, since sessions report it seconds apart.
declare -A usage_seen
load_usage_seen() {
  local key v
  [[ -f $limits ]] || return 0
  while IFS=$'\t' read -r key v; do
    if [[ $key == limit\ * || $key == context\ * ]] && [[ $v =~ ^[0-9]+$ ]]; then usage_seen[$key]=$v; fi
  done <"$limits"
}

save_usage_seen() {
  local key v
  for key in "${!usage_seen[@]}"; do
    v=${usage_seen[$key]}
    case $key in
    limit\ *) ((v > EPOCHSECONDS)) || continue ;;
    context\ *) [[ -f $usage_dir/${key#context }.json ]] || continue ;;
    esac
    printf '%s\t%s\n' "$key" "$v"
  done >"$limits.tmp"
  mv -f "$limits.tmp" "$limits"
}

note_limits() {
  local p w _pct resets old
  while read -r p w _pct resets; do
    [[ -n $p ]] || continue
    old=${usage_seen["limit $p $w"]:-}
    if [[ -n $old ]] && ((resets - old <= 300 && old - resets <= 300)); then continue; fi
    usage_seen["limit $p $w"]=$resets
    usage_woke=1
  done < <(limit_crossings)
}

note_contexts() {
  local name _status sid _profile tokens window
  while IFS=$'\037' read -r name _status sid _profile tokens window; do
    [[ $name =~ $crew_re && -n $sid && -z ${usage_seen["context $sid"]:-} ]] || continue
    context_k "$tokens" "$window" >/dev/null || continue
    usage_seen["context $sid"]=$EPOCHSECONDS
    usage_woke=1
  done <<<"$agent_rows"
}

# One herdr attempt; a failure skips this round, since retrying here would
# hold up the wait and ending the sweep would drop everything else it reports.
usage_woke=0
check_usage() {
  usage_at=$SECONDS
  agents_once || return 0
  note_limits
  note_contexts
}

report_since() {
  local report=$1 updated=$2
  [[ $updated =~ ^[0-9]+$ ]] || updated=0
  local t
  t=$(stat -c %Y "$report" 2>/dev/null) && ((t > updated))
}

# A question, blocked or handoff report newer than the row's update waits on
# the lead or the user; answering it bumps updated, which ends the wait.
waits_on_answer() {
  report_since "$1" "$2" && [[ $(crew_report_status "$1") =~ ^(question|blocked|handoff)$ ]]
}

last_progress() {
  local id=$1 branch=$2 latest=$3 item="$crew/items/$1" f t
  [[ $latest =~ ^[0-9]+$ ]] || latest=0
  for f in "$item/report.md" "$item/notes.md" "$item/merging"; do
    if t=$(stat -c %Y "$f" 2>/dev/null) && ((t > latest)); then latest=$t; fi
  done
  if [[ -n $branch ]] && t=$(GIT_OPTIONAL_LOCKS=0 git -C "$main" log -1 --format=%ct "refs/heads/$branch" -- 2>/dev/null) &&
    [[ $t =~ ^[0-9]+$ ]] && ((t > latest)); then
    latest=$t
  fi
  echo "$latest"
}

quiet_since() {
  [[ $1 =~ ^[0-9]+$ ]] && ((EPOCHSECONDS - $1 > quiet))
}

worker_line() {
  local id=$1 owner=$2 branch=$3 updated=$4 status=$5 flags=$6 screen rc
  local item="$crew/items/$id" merge_state
  merge_state=$(crew_merge_state "$item/merging")
  if [[ $merge_state == queued ]]; then
    flags+=" MERGING"
  elif [[ $merge_state == running ]]; then
    flags+=" MERGING"
    quiet_since "$(stat -c %Y "$item/merging" 2>/dev/null)" && flags+=" QUIET"
  else
    if [[ $status == idle || $status == done ]] && ! report_since "$item/report.md" "$updated"; then
      flags+=" IDLE"
    fi
    if ! waits_on_answer "$item/report.md" "$updated" && quiet_since "$(last_progress "$id" "$branch" "$updated")"; then
      flags+=" QUIET"
    fi
  fi
  if [[ $status == blocked ]]; then
    screen=$(timeout 10 herdr agent read "$owner" --source visible --lines "$screen_lines" 2>&1)
    rc=$?
    if ((rc != 0)) && [[ $screen == *agent_not_found* ]]; then
      echo "GONE $owner"
      return
    fi
    ((rc == 0)) || screen="(screen read failed: ${screen//$'\n'/ })"
    echo "WORKER $owner item $id $status$flags DIALOG"
    sed -e :a -e '/^[[:space:]]*$/{$d;N;ba' -e '}' <<<"$screen" | sed 's/^/  /'
    return
  fi
  echo "WORKER $owner item $id $status$flags"
}

report_workers() {
  local id status owner branch _into updated _rest
  while IFS=$'\037' read -r id status owner branch _into updated _rest; do
    [[ $status == assigned && -n $owner ]] || continue
    if agent_fields "$owner"; then
      worker_line "$id" "$owner" "$branch" "$updated" "$agent_status" "$(usage_flags)"
    else
      echo "GONE $owner"
    fi
  done < <(crew_board "$board")
}

# The first assigned and first blocked row each owner holds.
declare -A assigned_to blocked_to
load_owners() {
  local id status owner _rest
  assigned_to=()
  blocked_to=()
  while IFS=$'\037' read -r id status owner _rest; do
    [[ -n $owner ]] || continue
    case $status in
    assigned) [[ -n ${assigned_to[$owner]:-} ]] || assigned_to[$owner]=$id ;;
    blocked) [[ -n ${blocked_to[$owner]:-} ]] || blocked_to[$owner]=$id ;;
    esac
  done < <(crew_board "$board")
}

report_spares() {
  local name _rest line k
  while IFS=$'\037' read -r name _rest; do
    [[ $name =~ $crew_re && -z ${assigned_to[$name]:-} ]] || continue
    agent_fields "$name" || continue
    line="SPARE $name $agent_status on $agent_profile"
    [[ -z ${blocked_to[$name]:-} ]] || line+=" holds ${blocked_to[$name]}"
    if k=$(context_k "$agent_tokens" "$agent_window"); then line+=" CONTEXT ${k}k"; fi
    echo "$line"
  done <<<"$agent_rows"
  report_empty_tabs
}

# Tabs come from one herdr attempt; when it fails the lines wait for the next
# sweep.
report_empty_tabs() {
  local out label
  out=$(timeout 10 herdr tab list 2>/dev/null) || return 0
  while IFS= read -r label; do
    [[ $label =~ $crew_re && -z ${assigned_to[$label]:-} ]] || continue
    agent_fields "$label" || echo "SPARE $label no agent"
  done < <(jq -r '.result.tabs[]? | .label | strings' <<<"$out" 2>/dev/null | awk '!seen[$0]++')
}

pool_profiles() {
  {
    claude-profile names 2>/dev/null
    echo default
  } | awk '/^[A-Za-z0-9_.-]+$/ && !seen[$0]++'
}

report_pool() {
  local p counts sp _sr wp _wr full
  while IFS= read -r p; do
    counts=$(awk -F'\037' -v p="$p" -v re="$crew_re" '$4 == p { all++; if ($1 ~ re) crew++ } END { print crew + 0 "/" all + 0 }' <<<"$agent_rows")
    read -r sp _sr wp _wr < <(crew_profile_usage "$p")
    full=
    if ((${counts#*/} >= profile_cap)) || at_least "${sp:-}" "$session_soft" || at_least "${wp:-}" "$week_soft"; then full=" FULL"; fi
    echo "POOL $p $counts/$profile_cap session ${sp:-?}% week ${wp:-?}%$full"
  done < <(pool_profiles)
}

merged_field() {
  awk -v k="$2" '$1 == k { v = $2 } END { print v }' "$1"
}

landed() {
  local file="$crew/items/$1/merged" tip into
  [[ -f $file ]] || return 1
  tip=$(merged_field "$file" tip)
  into=$(merged_field "$file" into)
  [[ $tip =~ ^[0-9a-f]{40,64}$ && -n $into ]] &&
    GIT_OPTIONAL_LOCKS=0 git -C "$main" merge-base --is-ancestor "$tip" "refs/heads/$into" 2>/dev/null
}

mtime_ns() {
  local t
  t=$(stat -c %.9Y "$1" 2>/dev/null) && t=${t/./} && [[ $t =~ ^[0-9]+$ ]] && echo "$t"
}

# A worker reports done or blocked after the cleanup that follows its merge;
# until then its leftovers are its own to remove.
landing_finished() {
  local item="$crew/items/$1" owner=$2 r m
  if [[ $(crew_report_status "$item/report.md") =~ ^(done|blocked)$ ]] &&
    r=$(mtime_ns "$item/report.md") && m=$(mtime_ns "$item/merged") && ((r > m)); then
    return 0
  fi
  [[ -z $owner || -n ${assigned_to[$owner]:-} ]] || ! agent_fields "$owner"
}

# `kind path` for each of an item's worktree, w/<id> branch and build dir that
# still exists.
item_leftovers() {
  local id=$1 path raw
  path=$(GIT_OPTIONAL_LOCKS=0 git -C "$main" worktree list --porcelain 2>/dev/null |
    awk -v b="branch refs/heads/w/$id" '/^worktree / { w = substr($0, 10) } $0 == b { print w; exit }')
  [[ -n $path || ! -d $main/.claude/worktrees/w-$id ]] || path=$main/.claude/worktrees/w-$id
  [[ -z $path ]] || echo "worktree $path"
  if GIT_OPTIONAL_LOCKS=0 git -C "$main" show-ref --verify -q "refs/heads/w/$id" 2>/dev/null; then echo "branch w/$id"; fi
  if [[ -f $crew/items/$id/build-dir ]] && IFS= read -r raw <"$crew/items/$id/build-dir" && [[ $raw == /* && -d $raw ]]; then
    echo "build-dir $raw"
  fi
}

report_leftovers() {
  local id status owner _rest kind path key
  local -A printed=()
  if [[ -f $leftovers ]]; then
    while IFS= read -r key; do printed[$key]=1; done <"$leftovers"
  fi
  while IFS=$'\037' read -r id status owner _rest; do
    [[ ($status == "done" || $status == blocked) && $id =~ ^[A-Za-z0-9_-]+$ ]] || continue
    if ! landed "$id" || ! landing_finished "$id" "$owner"; then continue; fi
    while read -r kind path; do
      key="$id"$'\t'"$kind"
      [[ -z ${printed[$key]:-} ]] || continue
      printed[$key]=1
      echo "LEFTOVER $id $kind $path"
      printf '%s\n' "$key" >>"$leftovers"
    done < <(item_leftovers "$id")
  done < <(crew_board "$board")
}

report_stale_merges() {
  local file id
  shopt -s nullglob
  for file in "$crew"/items/*/merging; do
    id=${file%/merging}
    id=${id##*/}
    if [[ $(crew_merge_state "$file") =~ ^(cut|stale) ]]; then echo "STALE-MERGE $id"; fi
  done
  shopt -u nullglob
}

# Open rows whose deps can all reach done are found by a fixpoint from the done
# and assigned rows; the rest can never start and get a DEPS line. A dep on a
# row with a status other than open, assigned, done or blocked counts as unknown,
# because the rest of the crew ignores such rows.
report_order() {
  [[ -f $board ]] || return 0
  crew_board "$board" | awk -F'\037' '
    function search(id, target,    stack, top, seen, cur, j, d) {
      top = 0
      stack[++top] = id
      while (top > 0) {
        cur = stack[top--]
        for (j = 1; j <= nd[cur]; j++) {
          d = dep[cur, j]
          if (!(d in known) || (d in seen)) continue
          seen[d] = 1
          if (target != "" && d == target) return d
          if (target == "" && status[d] == "blocked") return d
          if (status[d] == "open" && !reach[d]) stack[++top] = d
        }
      }
      return ""
    }
    function problem(id,    j, root) {
      for (j = 1; j <= nd[id]; j++) if (!(dep[id, j] in known)) return "names unknown " dep[id, j]
      for (j = 1; j <= nd[id]; j++) if (status[dep[id, j]] == "blocked") return "waits on blocked " dep[id, j]
      if (search(id, id) != "") return "is in a cycle"
      root = search(id, "")
      if (root != "") return "waits on blocked " root
      for (j = 1; j <= nd[id]; j++) if (!reach[dep[id, j]]) return "waits on stuck " dep[id, j]
    }
    $1 != "" && $2 ~ /^(open|assigned|done|blocked)$/ {
      if (!($1 in known)) order[++n] = $1
      known[$1] = 1
      status[$1] = $2
      raw[$1] = $8
    }
    END {
      for (i = 1; i <= n; i++) {
        id = order[i]
        nd[id] = split(raw[id], parts, ",")
        for (j = 1; j <= nd[id]; j++) dep[id, j] = parts[j]
        reach[id] = status[id] == "done" || status[id] == "assigned"
      }
      do {
        changed = 0
        for (i = 1; i <= n; i++) {
          id = order[i]
          if (reach[id] || status[id] != "open") continue
          ok = 1
          for (j = 1; j <= nd[id]; j++) if (!reach[dep[id, j]]) ok = 0
          if (ok) { reach[id] = 1; changed = 1 }
        }
      } while (changed)
      for (i = 1; i <= n; i++) {
        id = order[i]
        if (status[id] != "open") continue
        if (!reach[id]) { print "DEPS " id " " problem(id); continue }
        ready = 1
        for (j = 1; j <= nd[id]; j++) if (status[dep[id, j]] != "done") ready = 0
        if (ready) print "READY " id
      }
    }
  '
}

report_heavy() {
  local slots lock="$crew/heavy.lock" holder purpose since
  if ! slots=$(crew_heavy_slots "$crew"); then
    echo "HEAVY failed: heavy-slots must contain 1"
    return
  fi
  ((slots)) && [[ -d $lock ]] || return 0
  if [[ ! -f $lock/holder ]] || ! IFS=$'\t' read -r holder purpose since <"$lock/holder" || [[ ! $since =~ ^[0-9]+$ ]]; then
    holder=unknown purpose=unknown
    since=$(stat -c %Y "$lock" 2>/dev/null) || return 0
  fi
  ((EPOCHSECONDS - since > heavy_long)) || return 0
  echo "HEAVY $holder $(((EPOCHSECONDS - since) / 60)) min $purpose"
}

report_reflect() {
  local file="$crew/reflections.md" t
  if ! t=$(stat -c %Y "$file" 2>/dev/null) || ((EPOCHSECONDS - t > reflect_every)); then
    echo REFLECT
  fi
}

# The output goes to a file, not a pipe, so a background child the check leaves
# behind cannot hold the sweep open.
run_sweep_check() {
  local check="$crew/sweep-check" out rc
  [[ -e $check ]] || return 0
  if [[ ! -x $check ]]; then
    echo "CHECK failed: sweep-check is not executable"
    return
  fi
  out=$(mktemp)
  (cd "$main" && GIT_OPTIONAL_LOCKS=0 exec timeout -k 5 "$check_timeout" "$check") >"$out" 2>&1 </dev/null
  rc=$?
  tail -n 20 "$out" | awk '{print "CHECK " $0}'
  rm -f "$out"
  if ((rc == 124 || rc == 137)); then
    echo "CHECK failed: sweep-check timed out after $check_timeout s"
  elif ((rc != 0)); then
    echo "CHECK failed: sweep-check exited $rc"
  fi
}

declare -A alerted
load_alerts() {
  local key t
  [[ -f $alerts ]] || return 0
  while IFS=$'\t' read -r key t; do
    if [[ -n $key && $t =~ ^[0-9]+$ ]]; then alerted[$key]=$t; fi
  done <"$alerts"
}

alerted_recently() {
  local t=${alerted[$1]:-}
  [[ -n $t ]] && ((EPOCHSECONDS - t < resource_hold))
}

save_alerts() {
  local key
  for key in "${!alerted[@]}"; do
    if alerted_recently "$key"; then printf '%s\t%s\n' "$key" "${alerted[$key]}"; fi
  done >"$alerts.tmp"
  mv -f "$alerts.tmp" "$alerts"
}

resource_keys() {
  local disk_re='^disk (.+) [0-9]+ GB free(, critical)? \('
  case $1 in
  memory\ *) keys=(memory) ;;
  load\ *) keys=(load) ;;
  io\ *) keys=(io) ;;
  *)
    keys=()
    if [[ $1 =~ $disk_re ]]; then
      keys=("disk ${BASH_REMATCH[1]}")
      [[ -z ${BASH_REMATCH[2]} ]] || keys+=("disk ${BASH_REMATCH[1]} critical")
    fi
    ;;
  esac
}

# A breach ends the wait when any of its keys has no recent alert; it then
# counts as alerted for all of them, so a falling disk wakes the lead once when
# it turns critical and not again when it recovers to merely low.
resource_lines=()
resource_woke=0
check_resources() {
  local out err rc line key fresh keys
  err=$(mktemp)
  out=$(cd "$main" && "$here/crew-resources" 2>"$err")
  rc=$?
  resource_lines=()
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    resource_lines+=("$line")
    resource_keys "$line"
    fresh=0
    for key in "${keys[@]}"; do alerted_recently "$key" || fresh=1; done
    if ((fresh)); then
      for key in "${keys[@]}"; do alerted[$key]=$EPOCHSECONDS; done
      resource_woke=1
    fi
  done <<<"$out"
  if ((rc != 0)); then
    if [[ -s $err ]]; then
      while IFS= read -r line; do resource_lines+=("failed: ${line#crew-resources: }"); done <"$err"
    else
      resource_lines+=("failed: crew-resources exited $rc")
    fi
  fi
  rm -f "$err"
  resources_at=$SECONDS
}

report_resources() {
  local line
  for line in "${resource_lines[@]}"; do echo "RESOURCE $line"; done
}

publish() {
  timeout 30 crew-dagr >/dev/null 2>&1 || true
  next_publish=$((SECONDS + publish_every))
}

check_role
publish
if all_done; then
  if agents_once; then
    load_owners
    report_pool
    report_spares
    report_leftovers
  fi
  echo ALL-DONE
  exit 0
fi

load_alerts
load_usage_seen
check_resources
check_usage
previous=$(cat "$seen" 2>/dev/null)
current=$(snapshot)
deadline=$((SECONDS + limit))
while [[ $current == "$previous" ]] && ((! resource_woke && ! usage_woke && SECONDS < deadline)); do
  sleep 1
  ((SECONDS >= next_publish)) && publish
  ((SECONDS >= resources_at + resource_every)) && check_resources
  ((SECONDS >= usage_at + resource_every)) && check_usage
  current=$(snapshot)
done
((resource_woke || SECONDS == resources_at)) || check_resources
((usage_woke || SECONDS == usage_at)) || check_usage
save_alerts
save_usage_seen

if [[ $current == "$previous" ]]; then
  ((resource_woke || usage_woke)) || echo TIMEOUT
else
  awk -F'\t' '
    NR == FNR { if ($0 != "") old[$1] = $0; next }
    $0 == "" { next }
    { now[$1] = 1; if (old[$1] != $0) print "CHANGED " $1 }
    END { for (p in old) if (!(p in now)) print "REMOVED " p }
  ' <(printf '%s\n' "$previous") <(printf '%s\n' "$current") | LC_ALL=C sort
fi

report_resources
agent_list
load_owners
report_limits
report_workers
report_spares
report_pool
report_leftovers
report_stale_merges
report_order
report_heavy
report_reflect
run_sweep_check

if [[ -n $current ]]; then
  printf '%s\n' "$current" >"$seen.tmp"
else
  : >"$seen.tmp"
fi
mv -f "$seen.tmp" "$seen"
publish
