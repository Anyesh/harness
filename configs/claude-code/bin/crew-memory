#!/usr/bin/env bash
# Usage: crew-memory ensure
#        crew-memory status
#
# Crew memory lives in the repo's wiki project folder, <vault>/wiki/projects/
# <slug>/crew, where wiki-sync carries it to the other machines. ensure moves
# the current repo's persistent files there while nothing can be reading them;
# status reports without changing anything. Every outcome is a `MEMORY <word>`
# line.
set -euo pipefail

# shellcheck source=crew-lib.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/crew-lib.sh"

die() {
  printf 'crew-memory: %s\n' "$*" >&2
  exit 1
}

usage() {
  sed -n '2,3s/^# \{0,1\}//p' "${BASH_SOURCE[0]}" >&2
  exit 2
}

split_handover() {
  local notes=$1 crew=$2
  grep -qx '## Handover' "$notes" || return 0
  awk '/^## / { f = ($0 == "## Handover") } f' "$notes" >>"$crew/handover.md"
  awk '/^## / { f = ($0 == "## Handover") } !f' "$notes" >"$notes.rest"
  mv -f "$notes.rest" "$notes"
}

link_index() {
  local project=$1 slug=$2 line='- [Crew memory](crew/index.md): crew lead notes, worker brief, gate scripts and one summary per run'
  [[ -f $project/index.md ]] || printf '# %s\n' "$slug" >"$project/index.md"
  grep -q 'crew/index\.md' "$project/index.md" || printf '%s\n' "$line" >>"$project/index.md"
}

# Copies the persistent files into a staging dir that wiki-sync ignores and
# renames it into place, so readers see either the crew dir's copy or the wiki's,
# then removes the originals.
move_in() {
  local crew=$1 root=$2 project stage f
  project=$(dirname "$root")
  stage="$project/.tmp-crew.$$"
  rm -rf "$stage"
  mkdir -p "$stage"
  for f in "${crew_mem_files[@]}"; do
    [[ -e $crew/$f ]] && cp -a "$crew/$f" "$stage/"
  done
  [[ ! -f $stage/lead-notes.md ]] || split_handover "$stage/lead-notes.md" "$crew"
  [[ ! -d $crew/runs ]] || cp -a "$crew/runs" "$stage/"
  printf '# Crew memory\n' >"$stage/index.md"
  [[ ! -f $crew/index.md ]] || grep -v '^# ' "$crew/index.md" >>"$stage/index.md" || true
  mv "$stage" "$root"
  for f in "${crew_mem_files[@]}" runs index.md; do
    rm -rf "${crew:?}/$f"
  done
  link_index "$project" "$(basename "$project")"
}

ensure() {
  (($# == 0)) || usage
  local root crew reason lockfd
  crew_wiki_vault >/dev/null || {
    echo "MEMORY no-vault"
    return 0
  }
  crew=$(crew_dir 2>/dev/null) || return 0
  root=$(crew_mem_root) || return 0
  mkdir -p "$crew"
  exec {lockfd}>"$crew/.mem.lock"
  flock "$lockfd"
  if [[ ! -d $root ]]; then
    if reason=$(crew_mem_busy "$crew"); then
      echo "MEMORY pending $reason"
    else
      move_in "$crew" "$root"
    fi
  fi
  exec {lockfd}>&-
}

section_bytes() {
  [[ -f $1 ]] || {
    echo 0
    return
  }
  awk -v h="## $2" '$0 == h { f = 1; next } f && /^## / { f = 0 } f { n += length($0) + 1 } END { print n + 0 }' "$1"
}

report_caps() {
  local root=$1 n cap
  crew_read_thresholds "$root/thresholds"
  cap=$((10#$(crew_threshold CREW_LESSONS_MAX_BYTES 8192)))
  n=$(section_bytes "$root/brief.md" Lessons)
  ((n <= cap)) || echo "MEMORY over crew/brief.md#Lessons $n/$cap"
}

report_strays() {
  local crew=$1 f
  for f in "${crew_mem_files[@]}"; do
    [[ ! -e $crew/$f ]] || echo "MEMORY stray $crew/$f"
  done
}

status() {
  (($# == 0)) || usage
  local root crew
  crew_wiki_vault >/dev/null || {
    echo "MEMORY no-vault"
    return 0
  }
  root=$(crew_mem_root 2>/dev/null) || return 0
  if [[ ! -d $root ]]; then
    echo "MEMORY repo $root not moved"
    return 0
  fi
  echo "MEMORY repo $root"
  crew=$(crew_dir)
  report_strays "$crew"
  report_caps "$root"
}

(($# >= 1)) || usage
cmd=$1
shift
case $cmd in
  ensure) ensure "$@" ;;
  status) status "$@" ;;
  *) usage ;;
esac
