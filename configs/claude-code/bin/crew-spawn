#!/usr/bin/env bash
set -uo pipefail

# shellcheck source=crew-lib.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/crew-lib.sh"

die() {
  printf 'crew-spawn: %s\n' "$*" >&2
  exit 4
}

usage="usage: crew-spawn [--lead] --model <model> --effort <low|medium|high|xhigh|max> <name> <profile>"
lead=0
model_arg=
effort=
while (($#)); do
  case $1 in
    --lead) lead=1 ;;
    --model)
      (($# > 1)) || die "$usage"
      model_arg=$2
      shift
      ;;
    --effort)
      (($# > 1)) || die "$usage"
      effort=$2
      shift
      ;;
    --*) die "$usage" ;;
    *) break ;;
  esac
  shift
done
(($# == 2)) || die "$usage"
name=$1
profile=$2
[[ $name =~ ^[a-z][a-z0-9_-]{0,31}$ ]] || die "invalid agent name: $name"
[[ -z $model_arg || $model_arg =~ ^[a-z0-9/._-]+$ ]] || die "invalid model: $model_arg"
if [[ $profile == opencode ]]; then
  [[ -z $effort ]] || die "opencode takes no --effort; its model's variant sets it"
else
  [[ -n $model_arg ]] || die "a Claude session needs --model, so it never inherits the profile's default model; $usage"
  [[ -n $effort ]] || die "a Claude session needs --effort, so it never inherits the profile's default effort; $usage"
  [[ $effort =~ ^(low|medium|high|xhigh|max)$ ]] || die "unknown effort level: $effort"
fi

end=$((SECONDS + ${CREW_SPAWN_DEADLINE:-540}))
prompt_timeout=${CREW_SPAWN_PROMPT_TIMEOUT:-120}
poll=${CREW_SPAWN_POLL:-1}
start_ms=${CREW_SPAWN_START_MS:-120000}
tries=3

kind=claude
if [[ $profile == opencode ]]; then
  kind=opencode
  ((! lead)) || die "the lead runs /crew, which needs Claude Code, so it cannot run in opencode"
  if grep -qxF opencode < <(claude-profile names 2>/dev/null); then
    die "a Claude profile is named opencode, so the profile opencode is ambiguous"
  fi
  model=${model_arg:-${CREW_OPENCODE_MODEL:-anthropic/claude-opus-5-5}}
  review_model=${CREW_OPENCODE_REVIEW_MODEL:-anthropic/claude-opus-5-5}
  command -v opencode >/dev/null || die "opencode unavailable: opencode is not on PATH"
  models=$(timeout 30 opencode models anthropic 2>&1) ||
    die "opencode unavailable: opencode models anthropic failed: ${models//$'\n'/ }"
  grep -qxF "$model" <<<"$models" || die "opencode unavailable: opencode models anthropic does not list $model"
fi

main=$(crew_main) || die "not inside a git repository"

exists() {
  echo "exists $name"
  exit 3
}

if err=$(timeout 10 herdr agent get "$name" 2>&1 >/dev/null); then
  exists
elif [[ $err != *'"code":"agent_not_found"'* ]]; then
  die "herdr agent get failed: $err"
fi
tabs=$(timeout 10 herdr tab list 2>&1) || die "herdr tab list failed: $tabs"
labelled=$(jq --arg l "$name" '[.result.tabs[] | select(.label == $l)] | length' <<<"$tabs") ||
  die "cannot read herdr tab list: $tabs"
((labelled == 0)) || exists

# herdr reports Claude's first-run screens and its login screen as a ready
# agent, so a profile that would open on either is refused before its tab.
check_claude_ready() {
  local state=$HOME/.claude.json setup="run claude-profile sync $profile" login="claude-$profile auth login" status logged rc
  if [[ $profile == default ]]; then
    setup="start claude once and finish its setup"
    login="claude auth login"
  else
    state=$(sed -n 's/^CLAUDE_CONFIG_DIR=//p' <<<"$profile_env")
    [[ -n $state ]] || die "claude-profile env $profile printed no CLAUDE_CONFIG_DIR"
    state+=/.claude.json
  fi
  jq -e '.hasCompletedOnboarding == true' "$state" >/dev/null 2>&1 ||
    die "profile $profile has not finished Claude's first-run setup; $setup"
  status=$(timeout 30 env -u CLAUDE_CONFIG_DIR -u CLAUDE_PROFILE -u ANTHROPIC_API_KEY -u CLAUDE_CODE_OAUTH_TOKEN \
    "${profile_vars[@]}" claude auth status 2>/dev/null </dev/null)
  rc=$?
  ((rc != 124)) || die "claude auth status for profile $profile timed out"
  # auth status exits 1 when signed out but still prints its JSON.
  logged=$(jq -r '.loggedIn' <<<"$status" 2>/dev/null) || logged=
  case $logged in
    true) ;;
    false) die "profile $profile is not signed in; run $login" ;;
    *) die "cannot read claude auth status for profile $profile: ${status//$'\n'/ }" ;;
  esac
}

envs=()
((lead)) || envs=(--env HARNESS_UNATTENDED=1 --env HARNESS_NOTIFY=0)
if [[ $kind == opencode ]]; then
  oc_config=$(jq -nc --arg review "$review_model" '{
    permission: {edit: "allow", bash: "allow", webfetch: "allow", external_directory: "allow", question: "deny"},
    agent: {"crew-review": {mode: "subagent", model: $review,
      description: "Reviews a change, plan or decision and advises; use it for every review, advice or second opinion."}}
  }') || die "cannot build the opencode config"
  envs+=(--env "OPENCODE_CONFIG_CONTENT=$oc_config")
else
  profile_env=
  if [[ $profile != default ]]; then
    profile_env=$(claude-profile env "$profile") || die "claude-profile env $profile failed"
  fi
  profile_vars=()
  while IFS= read -r kv; do
    [[ -n $kv ]] && profile_vars+=("$kv") && envs+=(--env "$kv")
  done <<<"$profile_env"
  check_claude_ready
fi
remotes=$(git -C "$main" remote) || die "git remote failed in $main"
n=0
for r in $remotes; do
  for v in "" /nonexistent/crew-no-push; do
    envs+=(--env "GIT_CONFIG_KEY_$n=remote.$r.pushurl" --env "GIT_CONFIG_VALUE_$n=$v")
    n=$((n + 1))
  done
done
((n)) && envs+=(--env "GIT_CONFIG_COUNT=$n")

created=$(timeout 30 herdr tab create --cwd "$main" --label "$name" --no-focus "${envs[@]}" 2>&1) ||
  die "herdr tab create failed: $created"
pane=$(jq -r '.result.root_pane.pane_id // empty' <<<"$created" 2>/dev/null)
[[ -n $pane ]] || die "herdr tab create returned no pane: $created"
echo "pane $pane"
if [[ $kind == opencode ]]; then
  rm -f "$(crew_usage_dir)/$(crew_pane_usage_key "$pane").json"
fi

shell_state() {
  local info
  info=$(timeout 10 herdr pane process-info --pane "$pane" 2>/dev/null) || {
    echo other
    return
  }
  jq -r --arg k "$kind" "$(crew_jq_agent_proc)"'.result.process_info
    | if any(.foreground_processes[]?; agent_proc($k))
      then "agent"
      elif (.shell_pid | type) == "number" and .shell_pid == .foreground_process_group_id
      then "prompt"
      else "other" end' <<<"$info" 2>/dev/null || echo other
}

wait_prompt() {
  local until=$((SECONDS + prompt_timeout))
  ((until > end)) && until=$end
  while :; do
    case $(shell_state) in
      prompt) return 0 ;;
      agent) return 1 ;;
    esac
    ((SECONDS < until)) || return 2
    sleep "$poll"
  done
}

wait_prompt
case $? in
  1) die "$kind is already in the foreground of pane $pane" ;;
  2) die "the shell in pane $pane did not reach its prompt" ;;
esac

if [[ $kind == opencode ]]; then agent_args=(-m "$model"); else agent_args=(--dangerously-skip-permissions --model "$model_arg" --effort "$effort"); fi
rc=
for ((try = 1; try <= tries; try++)); do
  left=$((end - SECONDS))
  ((left > 0)) || break
  ms=$((left * 1000))
  ((ms > start_ms)) && ms=$start_ms
  timeout $((ms / 1000 + 10)) herdr agent start "$name" --kind "$kind" --pane "$pane" --timeout "$ms" \
    -- "${agent_args[@]}" >&2
  rc=$?
  ((rc == 0)) && exit 0
  ((try < tries)) || break
  wait_prompt || break
done
[[ -n $rc ]] || die "no time left to start the agent in pane $pane"
exit "$rc"
