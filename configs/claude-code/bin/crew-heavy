#!/usr/bin/env bash
# Usage: crew-heavy acquire <holder> <purpose> [max-wait-seconds]   (default 7200)
#        crew-heavy release <holder>
#        crew-heavy status
#        crew-heavy holds <holder>   (exit 0 when <holder> holds the slot, 1 otherwise)
#        crew-heavy run <holder> <purpose> [max-wait-seconds] -- <command...>
#
# One machine-wide slot for memory-heavy work, held as the directory
# <crew dir>/heavy.lock with a holder file `holder<TAB>purpose<TAB>epoch`.
# Each waiter holds a ticket in <crew dir>/heavy.queue named
# `<epoch microseconds, zero-padded>.<pid>.<holder>` and may take the lock only
# while no live ticket is ahead of it. Merge gates (`merge-<id>`), holders listed
# in <crew dir>/heavy-priority and tickets older than CREW_HEAVY_AGE seconds
# (default 3600) go first, oldest first, then everyone else oldest first. With
# heavy-slots set, a normal waiter also stays behind every live crew-merge
# marker whose merge has neither the slot nor a ticket yet.
set -euo pipefail
# shellcheck source=crew-lib.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/crew-lib.sh"

die() {
  printf 'crew-heavy: %s\n' "$*" >&2
  exit 1
}

crew=$(crew_dir) || die "not inside a git repository"
slots=$(crew_heavy_slots "$crew") || die "$crew/heavy-slots must contain 1, the only slot count supported"
lock=$crew/heavy.lock
queue=$crew/heavy.queue
ticket=
poll=${CREW_HEAVY_POLL:-15}

holder_line() {
  [[ -f $lock/holder ]] && cat "$lock/holder"
}

current_holder() {
  crew_heavy_hold "$crew" | cut -f1
}

# crew-merge takes its ticket only after it holds crew-merge.lock and has
# prepared the merge, so between two merges the slot would sit free with no
# priority ticket in the queue.
merges_without_ticket() {
  local m id n=0 hold
  hold=$(current_holder)
  for m in "$crew"/items/*/merging; do
    [[ -f $m ]] || continue
    id=${m%/merging}
    id=${id##*/}
    [[ $hold != "merge-$id" && " $1 " != *" merge-$id "* ]] || continue
    case $(crew_merge_state "$m") in
    queued | running) n=$((n + 1)) ;;
    esac
  done
  echo "$n"
}

# Prints how many waiters are ahead of ticket $1, removing dead tickets.
tickets_ahead() {
  local t class holder path mine='' holders='' n=0
  for t in "$queue"/*; do
    if [[ -e $t ]] && ! crew_heavy_ticket_live "$t"; then rm -f "$t"; fi
  done
  while IFS=$'\t' read -r class holder _ path; do
    holders+=" $holder"
    if [[ $path == "$1" ]]; then
      mine=$class
    elif [[ -z $mine ]]; then
      n=$((n + 1))
    fi
  done < <(crew_heavy_queue "$crew")
  if [[ $mine != 0 && $slots == 1 ]]; then
    n=$((n + $(merges_without_ticket "$holders")))
  fi
  echo "$n"
}

drop_ticket() {
  [[ -n $ticket ]] && rm -f "$ticket"
  ticket=
}

acquire() {
  local holder=$1 purpose=$2 max_wait=${3:-7200} start=$EPOCHSECONDS next_note=$EPOCHSECONDS ahead
  [[ $holder =~ ^[A-Za-z0-9_.-]+$ ]] || die "holder must be an item id or name"
  [[ $max_wait =~ ^[0-9]+$ ]] || die "max wait must be whole seconds"
  mkdir -p "$queue"
  printf -v ticket '%s/%020d.%s.%s' "$queue" "$((10#${EPOCHREALTIME//[!0-9]/}))" "$$" "$holder"
  trap drop_ticket EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  while :; do
    if [[ $(current_holder) == "$holder" ]]; then
      drop_ticket
      echo "crew-heavy: $holder already holds the slot"
      return 0
    fi
    [[ -e $ticket ]] || : >"$ticket"
    ahead=$(tickets_ahead "$ticket")
    ((ahead == 0)) && mkdir "$lock" 2>/dev/null && break
    ((EPOCHSECONDS - start >= max_wait)) && die "gave up after $((EPOCHSECONDS - start))s; held by: $(holder_line || echo unknown)"
    if ((EPOCHSECONDS >= next_note)); then
      echo "crew-heavy: waiting, $ahead ahead in the queue; held by: $(holder_line || echo unknown)"
      next_note=$((EPOCHSECONDS + 300))
    fi
    sleep "$poll" &
    wait "$!"
  done
  printf '%s\t%s\t%s\n' "$holder" "$purpose" "$EPOCHSECONDS" >"$lock/holder"
  drop_ticket
  trap - EXIT HUP INT TERM
  echo "crew-heavy: acquired by $holder for $purpose"
}

release() {
  local holder=$1 current
  [[ -d $lock ]] || {
    echo "crew-heavy: slot is free"
    return 0
  }
  current=$(current_holder)
  [[ $current == "$holder" ]] || die "slot is held by ${current:-unknown}, not $holder"
  rm -f "$lock/holder"
  rmdir "$lock"
  echo "crew-heavy: released by $holder"
}

status() {
  if [[ -d $lock ]]; then
    local h p t
    IFS=$'\t' read -r h p t < <(holder_line || printf 'unknown\tunknown\t%s\n' "$EPOCHSECONDS")
    echo "held by $h for $p, $(((EPOCHSECONDS - t) / 60)) min"
  else
    echo "free"
  fi
  local waiting
  mapfile -t waiting < <(crew_heavy_waiters "$crew" | cut -f1)
  ((${#waiting[@]})) || return 0
  local list
  printf -v list '%s, ' "${waiting[@]}"
  echo "waiting: ${list%, }"
}

cmd=${1:-}
shift || true
case $cmd in
acquire)
  (($# >= 2)) || die "usage: crew-heavy acquire <holder> <purpose> [max-wait-seconds]"
  acquire "$@"
  ;;
release)
  (($# == 1)) || die "usage: crew-heavy release <holder>"
  release "$1"
  ;;
status) status ;;
holds)
  (($# == 1)) || die "usage: crew-heavy holds <holder>"
  [[ $(current_holder) == "$1" ]]
  ;;
run)
  (($# >= 2)) || die "usage: crew-heavy run <holder> <purpose> [max-wait-seconds] -- <command...>"
  holder=$1 purpose=$2
  shift 2
  max_wait=7200
  if [[ ${1:-} != -- && $# -gt 0 ]]; then
    max_wait=$1
    shift
  fi
  [[ ${1:-} == -- ]] || die "run needs -- before the command"
  shift
  acquire "$holder" "$purpose" "$max_wait"
  trap 'release "$holder" >/dev/null' EXIT
  trap 'exit 129' HUP
  trap 'exit 143' TERM
  "$@"
  ;;
*) die "usage: crew-heavy acquire|release|status|holds|run" ;;
esac
