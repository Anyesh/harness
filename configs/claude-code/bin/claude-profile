#!/usr/bin/env bash
set -euo pipefail

MAIN_DIR="$HOME/.claude"
MAIN_STATE="$HOME/.claude.json"
BIN_DIR="$HOME/.local/bin"

# Shared with every profile because they are harness config or work that should
# follow you across accounts (transcripts and auto-memory live in projects/).
# Sign-in (.credentials.json) and .claude.json stay per profile, which is the
# point of having profiles. Handoffs are not here because they live outside
# every config dir, in ~/.local/state/harness/handoffs.
SHARED=(
  CLAUDE.md settings.json .mcp.json keybindings.json
  hooks scripts skills commands agents plugins harness-mods dev-mods verdant-bash.toml
  projects plans
)
RESERVED=(profile list names env sync remove help)

usage() {
  cat <<'EOF'
Usage: claude-profile [name]        create or repair a profile (asks for a name if omitted)
       claude-profile list          show profiles and the account each is signed in to
       claude-profile names         print profile names, one per line
       claude-profile names --work on|off
                                    only the profiles whose work state matches
       claude-profile env <name>    print the variables that run a session as that profile
       claude-profile sync [name]   relink profiles to ~/.claude and merge new MCP servers
       claude-profile remove <name> delete a profile and its launcher
       claude-profile remove --all [--yes]
                                    delete every profile (--yes skips the prompt)

A profile is ~/.claude-<name> with its own sign-in, sharing the harness config,
skills, plugins and project history from ~/.claude. Start it with claude-<name>.

To give a profile its own settings, skills, rules or commands, describe the
differences in ~/.config/harness/profiles/<name>/ (see the harness repo's
configs/claude-code/profiles/example) and run ./install.sh --profile <name>.
EOF
}

die() {
  printf 'claude-profile: %s\n' "$*" >&2
  exit 1
}

warn() {
  printf 'claude-profile: %s\n' "$*" >&2
}

profile_dir() { printf '%s/.claude-%s' "$HOME" "$1"; }
launcher_path() { printf '%s/claude-%s' "$BIN_DIR" "$1"; }

is_our_launcher() {
  local name="${1##*/claude-}"
  [[ -f "$1" ]] && grep -qx "export CLAUDE_PROFILE=$name" "$1"
}

our_profiles() {
  local launcher
  for launcher in "$BIN_DIR"/claude-*; do
    is_our_launcher "$launcher" && printf '%s\n' "${launcher##*/claude-}"
  done
  return 0
}

# A profile's work state is the one the installer recorded; a profile it never
# rendered shares main's settings, so main's HARNESS_WORK answers for it.
profile_work_state() {
  local recorded
  recorded=$(awk '$1 == "work" { print $2 }' "$(profile_dir "$1")/.harness-owned" 2>/dev/null)
  if [[ -n "$recorded" ]]; then
    printf '%s\n' "$recorded"
  elif [[ "$(jq -r '.env.HARNESS_WORK // "0"' "$MAIN_DIR/settings.json" 2>/dev/null)" == 1 ]]; then
    printf 'on\n'
  else
    printf 'off\n'
  fi
}

profiles_with_work() {
  local want="$1" name
  [[ "$want" == on || "$want" == off ]] || die "--work takes on or off"
  while IFS= read -r name; do
    [[ "$(profile_work_state "$name")" == "$want" ]] && printf '%s\n' "$name"
  done < <(our_profiles)
  return 0
}

validate_name() {
  local name="$1" reserved
  [[ "$name" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] ||
    die "'$name' is not a valid name; use lowercase letters, digits and dashes"
  for reserved in "${RESERVED[@]}"; do
    [[ "$name" != "$reserved" ]] || die "'$name' is reserved"
  done
}

ensure_launcher_free() {
  local name="$1" path existing
  path=$(launcher_path "$name")
  if [[ -e "$path" ]]; then
    is_our_launcher "$path" || die "$path exists and was not made by claude-profile"
    return 0
  fi
  existing=$(command -v "claude-$name" || true)
  [[ -z "$existing" ]] || die "claude-$name already exists at $existing"
}

spec_dir() { printf '%s/harness/profiles/%s' "${XDG_CONFIG_HOME:-$HOME/.config}" "$1"; }

# Written by the harness installer for entries a profile spec overrides, and for
# MCP servers the profile must not get (memory=off).
owned_by_install() {
  local dir="$1" kind="$2"
  awk -v k="$kind" '$1 == k { print $2 }' "$dir/.harness-owned" 2>/dev/null || true
}

link_shared() {
  local dir="$1" entry src dest owned
  owned=$(owned_by_install "$dir" owned)
  for entry in "${SHARED[@]}"; do
    grep -qxF -- "$entry" <<<"$owned" && continue
    src="$MAIN_DIR/$entry"
    dest="$dir/$entry"
    if [[ -L "$dest" && ! -e "$dest" && "$(readlink "$dest")" == "$src" ]]; then
      rm "$dest"
    fi
    [[ -e "$src" ]] || continue
    if [[ -L "$dest" ]]; then
      [[ "$(readlink "$dest")" == "$src" ]] || warn "$dest points to $(readlink "$dest"), leaving it"
      continue
    fi
    if [[ -e "$dest" ]]; then
      warn "$dest is a separate copy, not shared with ~/.claude/$entry; delete it and run 'claude-profile sync' to share it"
      continue
    fi
    ln -s "$src" "$dest"
  done
}

# Profile-only servers survive; a server defined in both takes the main entry so
# that harness updates to it reach every profile.
merge_mcp_servers() {
  local dir="$1" state tmp drop
  [[ -f "$MAIN_STATE" ]] || return 0
  state="$dir/.claude.json"
  [[ -f "$state" ]] || printf '{}\n' >"$state"
  drop=$(owned_by_install "$dir" drop-mcp | jq -R . | jq -s .)
  tmp=$(mktemp "$state.XXXXXX")
  if jq --slurpfile main "$MAIN_STATE" --argjson drop "$drop" \
    '.mcpServers = ((.mcpServers // {}) + ($main[0].mcpServers // {}) | del(.[$drop[]]))' "$state" >"$tmp"; then
    mv "$tmp" "$state"
  else
    rm -f "$tmp"
    warn "could not merge MCP servers into $state"
  fi
}

write_launcher() {
  local name="$1" path
  path=$(launcher_path "$name")
  mkdir -p "$BIN_DIR"
  cat >"$path" <<EOF
#!/usr/bin/env bash
export CLAUDE_PROFILE=$name
export CLAUDE_CONFIG_DIR="\$HOME/.claude-$name"
exec claude "\$@"
EOF
  chmod +x "$path"
}

account_of() {
  local status account
  # auth status exits 1 when signed out but still prints its JSON, so the exit
  # code cannot tell signed out from broken.
  status=$("$(launcher_path "$1")" auth status 2>/dev/null) || true
  account=$(jq -r 'if .loggedIn then (.email // "signed in") else "not signed in" end' <<<"$status" 2>/dev/null) || true
  printf '%s\n' "${account:-unknown}"
}

create() {
  local name="$1" dir account reply
  if [[ -z "$name" ]]; then
    read -rp "Profile name (e.g. work, personal): " name || true
  fi
  [[ -n "$name" ]] || die "no profile name given"
  validate_name "$name"
  ensure_launcher_free "$name"
  [[ -d "$MAIN_DIR" ]] || die "$MAIN_DIR not found; run the harness install first"

  dir=$(profile_dir "$name")
  mkdir -p "$dir"
  chmod 700 "$dir"
  link_shared "$dir"
  merge_mcp_servers "$dir"
  write_launcher "$name"
  printf 'Profile %s ready at %s, start it with claude-%s\n' "$name" "$dir" "$name"
  [[ ":$PATH:" == *":$BIN_DIR:"* ]] || warn "$BIN_DIR is not on PATH, so claude-$name will not be found until it is"
  if [[ -d "$(spec_dir "$name")" ]]; then
    printf 'Found overrides in %s; apply them with ./install.sh --profile %s from the harness repo\n' "$(spec_dir "$name")" "$name"
  fi

  account=$(account_of "$name")
  if [[ "$account" != "not signed in" && "$account" != unknown ]]; then
    printf 'Signed in as %s\n' "$account"
    return 0
  fi
  read -rp "Sign in to the account for this profile now? [Y/n] " reply || reply=n
  if [[ "$reply" =~ ^([Yy].*)?$ ]]; then
    "$(launcher_path "$name")" auth login
  else
    printf 'Sign in later with: claude-%s auth login\n' "$name"
  fi
}

list() {
  local name found=false
  while read -r name; do
    found=true
    if [[ -d "$(profile_dir "$name")" ]]; then
      printf '%-16s %-36s %s\n' "$name" "$(account_of "$name")" "$(profile_dir "$name")"
    else
      printf '%-16s %-36s %s\n' "$name" "missing directory" "$(profile_dir "$name")"
    fi
  done < <(our_profiles)
  [[ "$found" == true ]] || printf 'No profiles yet; create one with claude-profile\n'
}

sync() {
  local only="${1:-}" name dir
  [[ -z "$only" ]] || validate_name "$only"
  while read -r name; do
    [[ -z "$only" || "$name" == "$only" ]] || continue
    dir=$(profile_dir "$name")
    if [[ ! -d "$dir" ]]; then
      warn "profile $name has a launcher but no $dir, skipping"
      continue
    fi
    link_shared "$dir"
    merge_mcp_servers "$dir"
    printf 'synced %s\n' "$name"
  done < <(our_profiles)
}

delete_profile() {
  local name="$1" launcher
  launcher=$(launcher_path "$name")
  rm -rf "$(profile_dir "$name")"
  if is_our_launcher "$launcher"; then
    rm -f "$launcher"
  fi
  printf 'Removed profile %s\n' "$name"
}

remove() {
  local name="$1" dir reply
  validate_name "$name"
  dir=$(profile_dir "$name")
  [[ -d "$dir" ]] || is_our_launcher "$(launcher_path "$name")" || die "no profile named $name"
  read -rp "This deletes $dir and its sign-in (shared files in ~/.claude are kept). Type '$name' to confirm: " reply || reply=
  [[ "$reply" == "$name" ]] || die "aborted"
  delete_profile "$name"
}

remove_all() {
  local confirmed="$1" names name reply
  mapfile -t names < <(our_profiles)
  if [[ ${#names[@]} -eq 0 ]]; then
    printf 'No profiles to remove\n'
    return 0
  fi
  if [[ "$confirmed" != true ]]; then
    read -rp "This deletes profiles ${names[*]} and their sign-ins (shared files in ~/.claude are kept). Type 'all' to confirm: " reply || reply=
    [[ "$reply" == all ]] || die "aborted"
  fi
  for name in "${names[@]}"; do
    delete_profile "$name"
  done
}

command -v jq >/dev/null || die "jq is required"

case "${1:-}" in
  list) list ;;
  names)
    if [[ "${2:-}" == --work ]]; then
      profiles_with_work "${3:-}"
    else
      our_profiles
    fi
    ;;
  env)
    [[ $# -eq 2 ]] || {
      usage >&2
      exit 1
    }
    is_our_launcher "$(launcher_path "$2")" || die "no profile named '$2'"
    printf 'CLAUDE_PROFILE=%s\nCLAUDE_CONFIG_DIR=%s\n' "$2" "$(profile_dir "$2")"
    ;;
  sync)
    [[ $# -le 2 ]] || {
      usage >&2
      exit 1
    }
    sync "${2:-}"
    ;;
  remove)
    case "$#:${2:-}:${3:-}" in
      "2:--all:") remove_all false ;;
      "3:--all:--yes") remove_all true ;;
      2:*) remove "$2" ;;
      *)
        usage >&2
        exit 1
        ;;
    esac
    ;;
  -h | --help | help) usage ;;
  *)
    [[ $# -le 1 ]] || {
      usage >&2
      exit 1
    }
    create "${1:-}"
    ;;
esac
