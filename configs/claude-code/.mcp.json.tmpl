{
  "mcpServers": {
    "second-brain": {
      "command": "second-brain-mcp",
      "env": {
        "SECOND_BRAIN_API": "http://127.0.0.1:7200"
      }
    },
    "web-strip": {
      "command": "node",
      "args": ["{{HOME_DIR}}/.harness/tools/web-strip/index.js"]
    },
    "markitdown": {
      "command": "uvx",
      "args": ["markitdown-mcp"]
    }
  }
}
