{
  "env": {
    "DISABLE_TELEMETRY": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "WIKI_VAULT": "{{WIKI_VAULT}}",
    "HARNESS_WORK": "{{HARNESS_WORK}}",
    "PLAYWRIGHT_MCP_HEADLESS": "true"
  },
  "disableClaudeAiConnectors": true,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [],
    "deny": [],
    "defaultMode": "auto"
  },
  "autoMode": {
    "classifyAllShell": true
  },
  "enabledMcpjsonServers": ["second-brain", "web-strip", "markitdown"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash {{HOME_DIR}}/.claude/hooks/pre-edit-code-quality.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 {{HOME_DIR}}/.claude/hooks/pre-edit-comment-guard.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash {{HOME_DIR}}/.claude/hooks/cost-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash {{HOME_DIR}}/.claude/hooks/pre-bash-guard.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash {{HOME_DIR}}/.claude/hooks/pre-bash-interactive-alias.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash {{HOME_DIR}}/.claude/hooks/publish-leak-guard.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash {{HOME_DIR}}/.claude/hooks/pre-plan-summary-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "AskUserQuestion|ExitPlanMode|EnterPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash {{HOME_DIR}}/.claude/hooks/crew-question-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash {{HOME_DIR}}/.claude/hooks/attention-notify.sh claude",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "bash {{HOME_DIR}}/.claude/hooks/attention-notify.sh claude",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash {{HOME_DIR}}/.claude/hooks/attention-notify.sh claude",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash {{HOME_DIR}}/.claude/hooks/attention-notify.sh claude",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash {{HOME_DIR}}/.claude/hooks/format-on-save.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash {{HOME_DIR}}/.claude/hooks/stop-sloppiness-guard.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash {{HOME_DIR}}/.claude/hooks/stop-wiki-enforce.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{HOME_DIR}}/.claude/hooks/humanize-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading humanize mode..."
          },
          {
            "type": "command",
            "command": "node \"{{HOME_DIR}}/.claude/hooks/ownit-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading ownit mode..."
          },
          {
            "type": "command",
            "command": "bash {{HOME_DIR}}/.claude/hooks/session-start-wiki.sh",
            "timeout": 5,
            "statusMessage": "Loading wiki index..."
          },
          {
            "type": "command",
            "command": "bash {{HOME_DIR}}/.claude/hooks/session-start-handoff.sh",
            "timeout": 15,
            "statusMessage": "Linking previous session digest..."
          },
          {
            "type": "command",
            "command": "mkdir -p \"${XDG_STATE_HOME:-$HOME/.local/state}/harness\" && bash {{HOME_DIR}}/.claude/hooks/worktree-sweep.sh --quiet --idle-hours 24 >> \"${XDG_STATE_HOME:-$HOME/.local/state}/harness/worktree-sweep.log\" 2>&1",
            "timeout": 120,
            "async": true
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash {{HOME_DIR}}/.claude/hooks/post-compact-context.sh",
            "timeout": 5,
            "statusMessage": "Restoring active scope..."
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{HOME_DIR}}/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{HOME_DIR}}/.claude/hooks/humanize-mode-tracker.js\"",
            "timeout": 5,
            "statusMessage": "Tracking humanize mode..."
          },
          {
            "type": "command",
            "command": "node \"{{HOME_DIR}}/.claude/hooks/ownit-mode-tracker.js\"",
            "timeout": 5,
            "statusMessage": "Tracking ownit mode..."
          },
          {
            "type": "command",
            "command": "bash {{HOME_DIR}}/.claude/hooks/attention-notify.sh claude",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash {{HOME_DIR}}/.claude/hooks/attention-notify.sh claude",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash {{HOME_DIR}}/.claude/hooks/session-end-ingest.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash {{HOME_DIR}}/.claude/hooks/session-end-handoff.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash {{HOME_DIR}}/.claude/scripts/statusline.sh",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false,
    "nudge-band@harness-mods": true,
    "cache-guard@harness-mods": true,
    "guard-watch@harness-mods": true,
    "context-audit@harness-mods": true
  },
  "extraKnownMarketplaces": {
    "harness-mods": {
      "source": {
        "source": "directory",
        "path": "{{HOME_DIR}}/.claude/harness-mods"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 500000
    }
  },
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "voiceEnabled": false,
  "showClearContextOnPlanAccept": true,
  "showThinkingSummaries": true
}
