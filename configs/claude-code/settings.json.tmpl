{
  "env": {
    "DISABLE_TELEMETRY": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "WIKI_VAULT": "{{WIKI_VAULT}}"
  },
  "permissions": {
    "allow": [],
    "deny": [],
    "defaultMode": "auto"
  },
  "enabledMcpjsonServers": ["second-brain", "cognitive-cache", "web-strip", "markitdown"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash {{HOME_DIR}}/.claude/hooks/pre-edit-code-quality.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 {{HOME_DIR}}/.claude/hooks/pre-edit-comment-guard.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash {{HOME_DIR}}/.claude/hooks/cost-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash {{HOME_DIR}}/.claude/hooks/pre-bash-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v rtk >/dev/null && rtk hook claude || exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash {{HOME_DIR}}/.claude/hooks/format-on-save.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash {{HOME_DIR}}/.claude/hooks/pre-compact.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash {{HOME_DIR}}/.claude/hooks/stop-sloppiness-guard.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash {{HOME_DIR}}/.claude/hooks/stop-wiki-enforce.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{HOME_DIR}}/.claude/hooks/humanize-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading humanize mode..."
          },
          {
            "type": "command",
            "command": "node \"{{HOME_DIR}}/.claude/hooks/ownit-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading ownit mode..."
          },
          {
            "type": "command",
            "command": "bash {{HOME_DIR}}/.claude/hooks/session-start-wiki.sh",
            "timeout": 5,
            "statusMessage": "Loading wiki index..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{HOME_DIR}}/.claude/hooks/humanize-mode-tracker.js\"",
            "timeout": 5,
            "statusMessage": "Tracking humanize mode..."
          },
          {
            "type": "command",
            "command": "node \"{{HOME_DIR}}/.claude/hooks/ownit-mode-tracker.js\"",
            "timeout": 5,
            "statusMessage": "Tracking ownit mode..."
          },
          {
            "type": "command",
            "command": "bash {{HOME_DIR}}/.claude/hooks/scope-drift-detector.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash {{HOME_DIR}}/.claude/hooks/wiki-nudge.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash {{HOME_DIR}}/.claude/hooks/cleanup-nudge.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash {{HOME_DIR}}/.claude/hooks/session-end-ingest.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash {{HOME_DIR}}/.claude/scripts/statusline.sh",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true
  },
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": false
}
