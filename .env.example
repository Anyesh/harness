# ~/.harness.env — optional overrides for template rendering
# Copy to ~/.harness.env only if you need to override defaults.
# All values below are auto-detected if left unset.

# HOME_DIR is auto-detected from $HOME — override only for non-standard setups
# HOME_DIR=/custom/home/path

# Path to Obsidian vault for LLM-maintained wiki
# WIKI_VAULT=~/Obsidian/SecondBrain
